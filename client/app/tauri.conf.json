{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LightNote",
  "version": "0.1.0",
  "identifier": "com.lightnote.app",
  "build": {
    "beforeDevCommand": "npm --prefix ../ run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm --prefix ../ run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LightNote",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
